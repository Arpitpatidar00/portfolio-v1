diff --git a/src/lib/seo.ts b/src/lib/seo.ts
new file mode 100644
index 0000000..b669902
--- /dev/null
+++ b/src/lib/seo.ts
@@ -0,0 +1,179 @@
+/* ─── SEO Helpers ────────────────────────────────────────────
+ * Single source of truth for URLs, page metadata and JSON-LD.
+ * Every page builds its <head> through `buildPageMetadata` so
+ * titles, descriptions, canonicals and social cards never drift.
+ * ──────────────────────────────────────────────────────────── */
+
+import type { Metadata } from "next";
+import { siteConfig, socialLinks } from "@/constants/config";
+
+/**
+ * Absolute origin of the deployed site (no trailing slash).
+ *
+ * Order of precedence:
+ * 1. NEXT_PUBLIC_SITE_URL       – set this to your real domain in production
+ * 2. VERCEL_PROJECT_PRODUCTION_URL – provided automatically by Vercel at build time
+ * 3. http://localhost:3000      – local development
+ */
+export function getSiteUrl(): string {
+  const explicit = process.env.NEXT_PUBLIC_SITE_URL;
+  if (explicit) return explicit.replace(/\/+$/, "");
+
+  const vercel = process.env.VERCEL_PROJECT_PRODUCTION_URL;
+  if (vercel) return `https://${vercel.replace(/\/+$/, "")}`;
+
+  return "http://localhost:3000";
+}
+
+export function absoluteUrl(path = "/"): string {
+  return `${getSiteUrl()}${path.startsWith("/") ? path : `/${path}`}`;
+}
+
+/** True only for the real production deployment (keeps previews out of Google). */
+export function isProductionDeployment(): boolean {
+  if (process.env.VERCEL_ENV) return process.env.VERCEL_ENV === "production";
+  return process.env.NODE_ENV === "production";
+}
+
+/* ─── Per-page metadata ──────────────────────────────────── */
+
+type PageSeo = {
+  /** Page-specific part of the title; the root template appends " | Arpit Patidar". */
+  title?: string;
+  description: string;
+  path: `/${string}`;
+};
+
+export function buildPageMetadata({ title, description, path }: PageSeo): Metadata {
+  const socialTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.title;
+
+  return {
+    ...(title ? { title } : {}),
+    description,
+    alternates: { canonical: path },
+    openGraph: {
+      title: socialTitle,
+      description,
+      url: path,
+      type: "website",
+    },
+    twitter: {
+      title: socialTitle,
+      description,
+    },
+  };
+}
+
+/* ─── Sitemap source ─────────────────────────────────────── */
+
+/**
+ * Indexable pages. Update `lastModified` when a page's content really changes,
+ * Google ignores lastmod values that change on every build.
+ */
+export const indexablePages: { path: `/${string}`; lastModified: string }[] = [
+  { path: "/", lastModified: "2026-10-12" },
+  { path: "/about", lastModified: "2026-10-12" },
+  { path: "/projects", lastModified: "2026-10-12" },
+  { path: "/contact", lastModified: "2026-10-12" },
+];
+
+/* ─── JSON-LD (schema.org) ───────────────────────────────── */
+
+type JsonLdNode = Record<string, unknown>;
+
+const personId = () => `${getSiteUrl()}/#person`;
+const websiteId = () => `${getSiteUrl()}/#website`;
+
+export function personJsonLd(): JsonLdNode {
+  return {
+    "@type": "Person",
+    "@id": personId(),
+    name: siteConfig.name,
+    url: absoluteUrl("/"),
+    image: absoluteUrl("/self1.jpeg"),
+    jobTitle: siteConfig.jobTitle,
+    description: siteConfig.description,
+    email: `mailto:${socialLinks.email}`,
+    address: {
+      "@type": "PostalAddress",
+      addressCountry: "IN",
+    },
+    worksFor: {
+      "@type": "Organization",
+      name: "Metaverse Ventures Pvt. Ltd.",
+    },
+    alumniOf: {
+      "@type": "CollegeOrUniversity",
+      name: "Chameli Devi Group of Institutions",
+    },
+    knowsAbout: siteConfig.keywords,
+    sameAs: [
+      socialLinks.github,
+      socialLinks.linkedin,
+      socialLinks.twitter,
+      socialLinks.instagram.url,
+    ],
+  };
+}
+
+export function websiteJsonLd(): JsonLdNode {
+  return {
+    "@type": "WebSite",
+    "@id": websiteId(),
+    url: absoluteUrl("/"),
+    name: `${siteConfig.name} — Portfolio`,
+    inLanguage: "en",
+    author: { "@id": personId() },
+    publisher: { "@id": personId() },
+  };
+}
+
+export function profilePageJsonLd(path: `/${string}`, name: string): JsonLdNode {
+  return {
+    "@type": "ProfilePage",
+    "@id": `${absoluteUrl(path)}#webpage`,
+    url: absoluteUrl(path),
+    name,
+    isPartOf: { "@id": websiteId() },
+    mainEntity: { "@id": personId() },
+  };
+}
+
+export function breadcrumbJsonLd(items: { name: string; path: `/${string}` }[]): JsonLdNode {
+  return {
+    "@type": "BreadcrumbList",
+    itemListElement: items.map((item, index) => ({
+      "@type": "ListItem",
+      position: index + 1,
+      name: item.name,
+      item: absoluteUrl(item.path),
+    })),
+  };
+}
+
+export function projectListJsonLd(
+  projects: { title: string; category: string; year: string; link: string; image: string }[],
+): JsonLdNode {
+  return {
+    "@type": "ItemList",
+    name: `Projects by ${siteConfig.name}`,
+    itemListElement: projects.map((project, index) => ({
+      "@type": "ListItem",
+      position: index + 1,
+      item: {
+        "@type": "CreativeWork",
+        name: project.title,
+        genre: project.category,
+        dateCreated: project.year.slice(0, 4),
+        creator: { "@id": personId() },
+        ...(project.link ? { url: project.link } : {}),
+        ...(project.image ? { image: absoluteUrl(project.image) } : {}),
+      },
+    })),
+  };
+}
+
+/** Wraps nodes in a single @graph document. */
+export function jsonLdGraph(...nodes: JsonLdNode[]): JsonLdNode {
+  return { "@context": "https://schema.org", "@graph": nodes };
+}
