# ─── SEO ──────────────────────────────────────────────────────
# Your real production domain (no trailing slash). Used for canonical URLs,
# the sitemap, Open Graph tags and structured data.
# On Vercel this can be omitted: VERCEL_PROJECT_PRODUCTION_URL is used instead,
# but a custom domain you own is strongly recommended.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Contact form (Nodemailer / SMTP) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
# For Gmail use an App Password, not your account password.
SMTP_PASSWORD=
RECEIVER_EMAIL=you@gmail.com

# ─── Media CDN (Cloudinary) ───────────────────────────────────
# Cloud name is public; it defaults to the portfolio's cloud in src/lib/cloudinary.ts.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=druv4ubsv
# Only needed locally to run `yarn assets:upload`. Never expose these to the browser
# and don't add them to your hosting provider.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
